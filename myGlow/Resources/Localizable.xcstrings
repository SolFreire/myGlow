            "value": "Clown white"
          }
        }
      }
    },
    "Tinta clown é uma base branca opaca, pra contraste teatral no rosto todo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clown white is an opaque white base, for theatrical contrast all over the face."
          }
        }
      }
    },
    "Toque duas vezes para guardar na maleta": {
      "extractionState": "manual",
