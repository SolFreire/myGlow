    "arte.fundo-tela-inicial" : {
      "comment" : "Fundo: a fachada do salão, na tela de abertura. Descreva o ambiente.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Salon facade with pink, purple, and green walls. The name above the door is in a frame illuminated by multiple light bulbs."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faixada do salão com paredes em rosa, roxo e verde. O nome acima da porta em uma moldura iluminada por várias lâmpadas. "
          }
        }
      }
    },
    "arte.icone-album-fotos" : {
      "comment" : "O quadro de fotos na parede do salão. Descreva o objeto.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flannel board with Polaroid photos, hanging between the mirrors"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flanelógrafocom fotografias polaroide, pendurado entre os espelhos."
