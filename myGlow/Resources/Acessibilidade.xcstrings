{
  "sourceLanguage" : "pt-BR",
  "strings" : {
    "arte.fundo-espelho-tutoriais" : {
      "comment" : "Fundo: a bancada com espelho, durante o tutorial. Descreva o ambiente.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A makeup vanity table filled with various product packaging and cosmetic brushes, set in front of a marquee vanity mirror framed with glowing light bulbs."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bancada de maquiagens, com diversas embalagens de produtos e pincéis, a frente de um espelho com sua moldura toda iluminada por lâmpadas."
          }
        }
      }
    },
    "arte.fundo-galeria" : {
      "comment" : "Fundo: a tela do álbum de fotos. Descreva o ambiente.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flannelgraph-textured surface"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superfície com textura do flanelógrafo. "
          }
        }
      }
    },
    "arte.fundo-salao" : {
      "comment" : "Fundo: o salão por dentro, no fluxo da Edna. Descreva o ambiente.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beauty salon with a blue and white checkered floor, pink chairs in front of illuminated mirrors, tables full of makeup items, a wooden bookshelf, and a pink sofa in the background."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salão de beleza com piso quadriculado azul e branco, cadeiras rosas diante de espelhos iluminados e mesas repletas de itens de maquiagem, uma estante de madeira e um sofá rosa ao fundo."
          }
        }
      }
    },
    "arte.fundo-salao-menu" : {
      "comment" : "Fundo: o salão do menu, sem os objetos. Descreva o ambiente.",
